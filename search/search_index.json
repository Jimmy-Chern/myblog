5\u5b9a\u7406","text":"<p>\u7fa4\u4f5c\u75281</p>"},{"location":"abstractAlgebra/#_2","title":"\u534a\u76f4\u79ef\uff0c\u76f4\u79ef\uff0c\u76f4\u548c\uff0c\u8303\u7574\u8bba\u62d3\u5e7f\u4e0b\u7684\u76f4\u79ef","text":"<p>\u76f4\u79ef</p>"},{"location":"abstractAlgebra/#_3","title":"\u7fa4\u540c\u6001\uff0c\u7fa4\u7684\u7b2c\u4e00\u3001\u7b2c\u4e8c\u3001\u7b2c\u4e09\u57fa\u672c\u540c\u6001\u5b9a\u7406","text":"<p>\u7fa4\u540c\u6001l1 \u7fa4\u540c\u6001l2</p>"},{"location":"abstractAlgebra/#_4","title":"\u5b50\u73af\uff0c\u73af\u540c\u6001\u4e0e\u540c\u6001\u57fa\u672c\u5b9a\u7406\uff0c\u7406\u60f3\u4e0e\u4e3b\u7406\u60f3","text":"<p>\u73af\u540c\u6001\u57fa\u672c\u5b9a\u7406</p>"},{"location":"bookReview/","title":"bookReview","text":"<p>\u4e66\u8bc4\u4ec5\u9650\u4e8e\u4f5c\u8005\u8bfb\u8fc7\u4e14\u6709\u6240\u611f\u89e6\u7684\u4e66\uff0c\u4ec5\u9650\u4e8e\u4f5c\u8005\u5543\u8fc7\u7684\u4e3b\u8981\u79d1\u76ee\uff0c\u73b0\u9636\u6bb5\u4ec5\u9650\u4e8e\u6570\u5b66</p>"},{"location":"bookReview/#_1","title":"\u6570\u5b66","text":""},{"location":"bookReview/#_2","title":"\u6570\u5b66\u5206\u6790","text":""},{"location":"bookReview/#_3","title":"\u9648\u7eaa\u4fee","text":"<p>\u63a8\u8350\u3002\u8fd9\u662f\u4e00\u672c\u6709\u5b9e\u9a8c\u7406\u5ff5\u7684\u6559\u6750\uff0c\u4f8b\u9898\u5f88\u591a\u90fd\u662f\u6709\u5e94\u7528\u80cc\u666f\u7684\uff0c\u6bd4\u5982\u8ba1\u7b97\u673a\u7684\u6570\u503c\u8ba1\u7b97\u3002\u8bc1\u660e\u662f\u6309\u601d\u7ef4\u6d41\u7a0b\u6765\u5199\uff0c\u5f88\u5c11\u770b\u5230\u6309\u6807\u51c6\u683c\u5f0f\u5199\u4f46\u8fdd\u80cc\u601d\u7ef4\u8fc7\u7a0b\u7684\u60c5\u51b5\uff0c\u8fd8\u6709\u5f88\u591a\u5f15\u5bfc\u7406\u89e3\u7684\u53e5\u5b50\u3002\u6709\u4eba\u8bf4\u8fd9\u672c\u6559\u6750\u96be\uff0c\u6211\u611f\u89c9\u4e5f\u6ca1\u6709\u3002</p>"},{"location":"bookReview/#_4","title":"\u534e\u5e08\u5927","text":"<p>\u4e00\u822c\u3002\u8bc1\u660e\u6709\u4e9b\u6309\u6807\u51c6\u6d41\u7a0b\u5199\uff0c\u8fdd\u80cc\u601d\u7ef4\u8fc7\u7a0b\uff0c\u4e0d\u592a\u81ea\u7136\uff0c\u770b\u7740\u4e0d\u8212\u670d\u3002\u8bfe\u540e\u4e60\u9898\u96be\u5ea6\u8df3\u7684\u592a\u5927\u3002\u4e0b\u518c\u611f\u89c9\u6709\u70b9\u8d76\u8fdb\u5ea6\uff0c\u5f88\u591a\u8bc1\u660e\u76f4\u63a5\u8df3\u4e86\u3002\u53ea\u80fd\u8bf4\u4e2d\u89c4\u4e2d\u77e9\uff0c\u4f46\u662f\u5982\u679c\u662f\u8003\u8bd5\u7528\u7684\u6559\u6750\u8fd8\u662f\u5fc5\u987b\u5f97\u770b\u3002</p>"},{"location":"bookReview/#_5","title":"\u5fae\u79ef\u5206\u5b66\u6559\u7a0b \u83f2\u8d6b\u91d1\u54e5\u5c14\u5179","text":"<p>\u4e00\u822c\u751a\u81f3\u4e0d\u63a8\u8350\u3002\u9762\u9762\u4ff1\u5230\u4f46\u662f\u7f3a\u4e4f\u91cd\u70b9\uff0c\u6ca1\u6709\u4e60\u9898\u3002\u4e00\u76f4\u770b\u7740\u5bb9\u6613\u56f0\uff0c\u800c\u4e14\u770b\u8fc7\u4e00\u904d\u5f88\u591a\u76f4\u63a5\u5c31\u5fd8\u4e86\u3002\u5f88\u96be\u60f3\u8c61\u6709\u4eba\u80fd\u5543\u4e0b\u8fd9\u4e48\u539a\u7684\u4e66\u3002</p>"},{"location":"bookReview/#_6","title":"\u6590\u793c\u6587\uff08\u4e60\u9898\u96c6\uff09","text":"<p>\u4e00\u822c\u3002\u6ca1\u4ec0\u4e48\u65b0\u9c9c\u77e5\u8bc6\uff0c\u8fd9\u4e2a\u5c31\u662f\u4e60\u9898\u96c6\u3002\u6709\u7684\u9898\u76ee\u8fc7\u4e8e\u96be\u800c\u4e14\u7f3a\u4e4f\u65b9\u6cd5\u5f15\u5bfc\uff0c\u6839\u672c\u6ca1\u6cd5\u505a\u4e5f\u5bb9\u6613\u56f0\uff0c\u5b9a\u79ef\u5206\u6781\u9650\u3001\u4e0d\u7b49\u5f0f\u90a3\u91cc\u7279\u522b\u5178\u578b\u3002</p>"},{"location":"bookReview/#_7","title":"\u8c22\u60e0\u6c11\uff08\u4e60\u9898\u96c6\uff09","text":"<p>\u63a8\u8350\u3002\u65b9\u6cd5\u5f15\u5bfc\u8fd8\u662f\u8db3\u591f\u7684\uff0c\u6709\u4e00\u4e9b\u51fa\u5f69\u7684\u7ed3\u8bba\u548c\u8bc1\u660e\u4f5c\u4e3a\u6559\u6750\u7684\u8865\u5145\uff0c\u4f8b\u5b50\uff08\u53cd\u4f8b\uff09\u4e5f\u662f\u4e00\u4e2a\u5f88\u597d\u7684\u8865\u5145\uff0c\uff08\u4f5c\u8005\u8865\u5145\u5b9a\u4f4d\u610f\u8bc6\u5f3a\uff09\u5c31\u662f\u6709\u7684\u9898\u592a\u96be\u4e86\uff0c\u82b1\u5f88\u591a\u65f6\u95f4\u4e5f\u662f\u767d\u8d39\uff0c\u6240\u4ee5\u5982\u679c\u6982\u5ff5\u548c\u4f5c\u4e1a\u6ca1\u505a\u597d\u6700\u597d\u522b\u78b0\u3002\u6709\u4eba\u5199\u4e86\u7b54\u6848\u4f46\u6211\u611f\u89c9\u5f88\u591a\u6280\u5de7\u6027\u592a\u5f3a\u4e86\uff0c\u4e0d\u5982\u7528\u57fa\u4e8e\u6982\u5ff5\u7406\u89e3\u672c\u8eab\u7684\u901a\u6cd5\uff08\u5f53\u7136\u4ec5\u9488\u5bf9\u8ba1\u7b97\u8fd9\u79cd\u57fa\u672c\u95ee\u9898\uff0c\u56e0\u4e3a\u8bc1\u660e\u6ca1\u6709\u901a\u6cd5\uff0c\u6280\u5de7\u6781\u5176\u91cd\u8981\uff09\uff0c\u8fd9\u79cd\u65b9\u6cd5\u53ef\u4ee5\u95eeAI\uff0c\u56e0\u4e3a\u5b83\u4e00\u822c\u5c31\u662f\u7528\u901a\u6cd5\u505a\u3002\u56e0\u4e3a\u5f88\u591a\u6280\u5de7\u770b\u4e86\u4e5f\u4e0d\u4f1a\uff0c\u8fd8\u63a9\u76d6\u4e86\u5bf9\u6982\u5ff5\u7684\u7406\u89e3\uff0c\u5c31\u662f\u5565\u4e5f\u6ca1\u6709,\u5f88\u5178\u578b\u7684\u5c31\u662f\u504f\u5fae\u5206\u65b9\u7a0b\u81ea\u53d8\u91cf\u548c\u56e0\u53d8\u91cf\u540c\u65f6\u4ee3\u6362\u90a3\u91cc\uff0c\u4f5c\u8005\u4e00\u5f00\u59cb\u88ab\u5404\u79cd\u6280\u5de7\u8ff7\u60d1\uff0c\u4f46\u662f\u6ca1\u641e\u61c2\u4f9d\u8d56\u5173\u7cfb\u8fd9\u4e2a\u672c\u8d28\uff0c\u5c31\u662f\u505a\u5f97\u6781\u5176\u75db\u82e6\u800c\u4e14\u7384\u5b66 \uff08\u5927\u4f6c\u53ef\u4ee5\u5ffd\u7565\u8fd9\u6bb5\u5e9f\u8bdd\uff0c\u672c\u4eba\u83dc\uff09\u3002</p>"},{"location":"bookReview/#_8","title":"\u963f\u6ce2\u65af\u6258\u5c14","text":"<p>\u4e0d\u63a8\u8350\u3002\u4e60\u9898\u653e\u5728\u4e00\u5927\u7ae0\u8282\u540e\u9762\uff0c\u5bb9\u6613\u61d2\uff0c\u4f46\u662f\u4e0d\u505a\u5c31\u6389\u961f\u4e86\u3002\u6b63\u6587\u5c31\u662f\u4e00\u5806\u8bc1\u660e\uff0c\u611f\u89c9\u4e5f\u4e0d\u5927\u81ea\u7136\uff0c\u770b\u5b8c\u5c31\u5fd8\u3002\u81ea\u5b66\u4e0d\u5efa\u8bae\u7528\u8fd9\u672c\u6559\u6750\uff0c\u8ddf\u82f1\u6587\u5bb9\u6613\u56f0\u4e5f\u6709\u5173\u7cfb\u3002</p>"},{"location":"bookReview/#_9","title":"\u6570\u5b66\u5206\u6790\u6559\u7a0b \u83f2\u8d6b\u91d1\u54e5\u5c14\u5179","text":"<p>\u4e0d\u63a8\u8350\u3002\u5c31\u662f\u5fae\u79ef\u5206\u5b66\u6559\u7a0b\u53bb\u6389\u4e00\u70b9\uff0c\u6ca1\u770b\u5230\u6709\u4ec0\u4e48\u597d\u5904\u3002</p>"},{"location":"bookReview/#_10","title":"\u7ebf\u6027\u4ee3\u6570","text":""},{"location":"bookReview/#_11","title":"\u8c22\u542f\u9e3f","text":"<p>\u63a8\u8350\u3002\u5b66\u4e60\u6307\u5bfc\u4e66\u6709\u5f88\u591a\u7ecf\u5178\u9898\u548c\u7ed3\u8bba\uff0c\u5bf9\u5e94\u5bf9\u8003\u8bd5\u5f88\u6709\u5e2e\u52a9\u3002</p>"},{"location":"bookReview/#_12","title":"\u8427\u6811\u94c1","text":"<p>\u63a8\u8350\u3002\u8bb2\u7684\u8fd8\u662f\u5f88\u6e05\u6670\u7684\uff0c\u5c31\u662f\u6bd4\u8f83\u6d45\uff0c\u662f\u5de5\u79d1\u7ebf\u4ee3\u7684\u6df1\u5ea6\u3002\u8865\u5145\u9898\u4e5f\u5f88\u597d\uff0c\u5305\u542b\u4e86\u8bb8\u591a\u5e38\u7528\u6280\u5de7\u3002\u6709\u7684\u8fdb\u9636\u77e5\u8bc6\u6bd4\u5982\u7fa4\u73af\u57df\u5c31\u662f\u63d0\u4e2a\u6982\u5ff5\uff0c\u76f8\u5f53\u4e8e\u6ca1\u8bb2\u3002</p>"},{"location":"bookReview/#_13","title":"\u7ebf\u6027\u4ee3\u6570\u5e94\u8be5\u8fd9\u6837\u5b66","text":"<p>\u63a8\u8350\u3002\u8fd9\u672c\u4e66\u7684\u7279\u70b9\u662f\u201c\u6253\u5012\u884c\u5217\u5f0f\u201d\u3002\u6240\u6709\u65b9\u9762\u90fd\u5f88\u597d\u3002\u8bc1\u660e\u81ea\u7136\uff0c\u4e60\u9898\u5f88\u591a\u90fd\u662f\u6709\u80cc\u666f\u7684\uff0c\u4f46\u662f\u80af\u5b9a\u662f\u53ea\u80fd\u7b2c\u4e8c\u904d\u518d\u5b66\u7684\u3002</p>"},{"location":"bookReview/#_14","title":"\u62bd\u8c61\u4ee3\u6570","text":""},{"location":"bookReview/#gtm76","title":"GTM76","text":"<p>\u4e0d\u63a8\u8350\u3002\u9762\u9762\u4ff1\u5230\u7f3a\u4e4f\u91cd\u70b9\u3002\u53c8\u662f\u82f1\u6587\u7684\uff0c\u5543\u8d77\u6765\u7279\u522b\u75db\u82e6\u3002\u8001\u5e08\u8bb2\u80af\u5b9a\u8bb2\u4e0d\u5b8c\uff0c\u81ea\u5b66\u53c8\u7d2f\u5b66\u4e0d\u52a8\uff0c\u611f\u89c9\u6709\u70b9\u9e21\u808b\u3002</p>"},{"location":"bookReview/#_15","title":"\u963f\u5ef7","text":"<p>\u63a8\u8350\u3002\u5f88\u9002\u5408\u81ea\u5b66\u7684\u4e00\u672c\u4e66\uff0c\u6982\u5ff5\u5bc6\u5ea6\u5c0f\u4f8b\u5b50\u591a\uff0c\u8bc1\u660e\u81ea\u7136\uff0c\u9664\u4e86\u8fdb\u5ea6\u6162\u4e4b\u5916\u6ca1\u4ec0\u4e48\u7f3a\u70b9\u3002</p>"},{"location":"bookReview/#_16","title":"\u7ec4\u5408\u6570\u5b66","text":""},{"location":"bookReview/#_17","title":"\u7ec4\u5408\u6570\u5b66 \u7406\u67e5\u5fb7","text":"<p>\u63a8\u8350\u3002\u8fd9\u672c\u4e66\u96be\u5ea6\u4e0d\u5927\uff0c\u89c2\u70b9\u90fd\u662f\u521d\u7b49\u7684\uff0c\u6ca1\u7528\u4ec0\u4e48\u9ad8\u7b49\u7684\u6570\u5b66\u5de5\u5177\uff0c\u4f8b\u5b50\u4e5f\u591a\uff0c\u4f46\u76f8\u5e94\u7684\u4e0d\u662f\u7279\u522b\u6df1\uff0c\u4e3b\u8981\u5c31\u662f\u8ba1\u6570\uff0c\u9762\u5411\u7684\u5c31\u662f\u5de5\u79d1\u540c\u5b66\u3002\u5c31\u662f\u9898\u592a\u591a\u4e86\uff0c\u9898\u7684\u7cbe\u7b80\u4e5f\u662f\u4f5c\u8005\u7528\u5fc3\u7684\u4e00\u79cd\u4f53\u73b0\u3002</p>"},{"location":"bookReview/#_18","title":"\u6781\u503c\u7ec4\u5408\u53ca\u8ba1\u7b97\u673a\u79d1\u5b66\u5e94\u7528","text":"<p>\u4e00\u822c\u3002\u4e2d\u79d1\u5927\u6570\u9662\u7528\u7684\u6559\u6750\uff0c\u5f88\u96be\u5f88\u786c\uff08&gt;&gt;\u4e0a\u9762\u90a3\u672c\uff09\uff0c\u8fd9\u4e2a\u770b\u56fd\u7c4d\u5c31\u77e5\u9053\u4e86\u3002\u4f8b\u5b50\u5c11\u4e86\uff0c\u76f4\u63a5\u4e0a\u96be\u5ea6\u3002\u7ec4\u5408\u8ba1\u6570\u53ea\u662f\u4e66\u7684\u4e00\u5c0f\u90e8\u5206\uff0c\u4e3b\u8981\u8ba8\u8bba\u7684\u8fd8\u662f\u7ec4\u5408\u6781\u503c\uff0c\u4f8b\u5982\u6c42\u6ee1\u8db3\u7279\u5b9a\u7ed3\u6784\u7684\u56fe\u7684\u6700\u5927\u9876\u70b9\u6570\u3002\u672c\u4e66\u9ed8\u8ba4\u8bfb\u8005\u5df2\u7ecf\u6709\u4e86\u76f8\u5f53\u7684\u6570\u5b66\u57fa\u7840\uff0c\u9700\u8981\u77e5\u9053\u56fe\u8bba\u548c\u62bd\u4ee3\u3002\u53ef\u80fd\u662f\u56e0\u4e3a\u8fc7\u5ea6\u91cd\u89c6\u8bc1\u660e\u8bed\u8a00\u7684\u4e25\u8c28\uff0c\u6709\u65f6\u5019\u6709\u7b80\u5355\u95ee\u9898\u8bf4\u7684\u590d\u6742\u7684\u611f\u89c9\uff0c\u8ba9ai\u89e3\u91ca\u4e00\u4e0b\u5c31\u770b\u61c2\u4e86\u3002\u4f46\u9274\u4e8e\u8be5\u9886\u57df\u6bd4\u8f83\u73b0\u4ee3\uff0c\u6559\u6750\u5e76\u4e0d\u591a\uff0c\u8fd9\u5df2\u7ecf\u662f\u6bd4\u8f83\u597d\u7684\u4e00\u672c\u3002</p>"},{"location":"bookReview/#_19","title":"\u56fe\u8bba\u5bfc\u5f15 \u97e6\u65af\u7279","text":"<p>\u63a8\u8350\u3002\u56fe\u6587\u5e76\u8302\uff0c\u4f8b\u5b50\u5f88\u591a\u800c\u4e14\u5f88\u57fa\u672c\u90fd\u5f88\u7ecf\u5178\uff0c\u5185\u5bb9\u7b97\u662f\u6df1\u5165\u7684\uff0c\u96be\u5ea6\u9ad8\u4e8e\u8ba1\u9662\u79bb\u6563\uff0c\u5927\u7ea6\u662f\u6570\u9662\u5165\u95e8\u7ea7\u3002</p>"},{"location":"bug/","title":"Bug","text":""},{"location":"bug/#mkdocs","title":"\u90e8\u7f72mkdocs","text":"<pre><code>mkdocs build\ngit init\ngit add .\ngit commit -m \"Deploy site\"\ngit remote add origin https://github.com/your-username/your-repo.git\ngit branch -M gh-pages\ngit push -u origin gh-pages --force\n</code></pre> <p>\u9047\u5230\u95ee\u9898</p> <pre><code>Permission denied (publickey).\n</code></pre> <p>\u89e3\u51b3\uff1a</p> <pre><code>ssh-keygen -t ed25519 -C \"your_email@example.com\"\neval \"$(ssh-agent -s)\"\nssh-add ~/.ssh/id_ed25519\n</code></pre> <p>\u5c06\u516c\u94a5\u6dfb\u52a0\u5230 GitHub \u8d26\u6237</p> <pre><code>ssh -T git@github.com\n</code></pre> <pre><code>git push -u origin gh-pages --force\n</code></pre> <p>\u9047\u5230\u95ee\u9898 gitpage\u4ec5\u663e\u793a\u6839\u76ee\u5f55\u4e0b\u7684readme\uff0c\u6ca1\u6709\u663e\u793asite/ \u539f\u56e0\uff1a\u4e4b\u524d\u7684\u65b9\u6cd5\u662f\u624b\u52a8\u90e8\u7f72\uff0c\u7136\u800c\u624b\u52a8\u90e8\u7f72\u5e94\u8be5push\u4e0a\u53bbsite\u6587\u4ef6\u5939\uff0c\u5426\u5219gitPage\u627e\u4e0d\u5230\u5165\u53e3 \u89e3\u51b3\uff1a \u8c03\u6574 mkdocs.yml \u914d\u7f6e</p> <pre><code>site_name: My Docs\nrepo_url: https://github.com/your-username/your-repo\ndocs_dir: docs\nsite_dir: site\nmkdocs build --clean\nmkdocs gh-deploy --force\n</code></pre> <p>github-setting-pages-branch: /root \u8fd9\u6837\u81ea\u52a8\u90e8\u7f72\u4e0a\u53bb\u7684\u5c31\u662fsite</p>"},{"location":"complexFunction/","title":"complexFunction","text":""},{"location":"complexFunction/#mitocwnote","title":"\u6559\u6750\uff1amitocw\u7535\u5b50note","text":"<p>MIT18.04 \u8fd9\u5957\u6559\u7a0b\u4ecd\u7136\u662f\u5de5\u79d1\u89c6\u89d2\u7684\u3002\u66f4\u52a0\u7406\u8bba\u5316\u7684\u590d\u5206\u6790\u9884\u8ba1\u5728\u672c\u6b21\u8bb0\u5f55\u4e4b\u540e\u5b8c\u6210\u3002</p>"},{"location":"complexFunction/#-","title":"\u67ef\u897f-\u9ece\u66fc\u65b9\u7a0b\uff0c\u89e3\u6790\u4e0e\u5168\u7eaf","text":"<p>C-R\u65b9\u7a0b</p>"},{"location":"graphTheory/","title":"graphTheory","text":"<p>\u4e3b\u8981\u662f\u4e3a\u5e94\u8bd5\u79ef\u7d2f\u7684\u9ad8\u6d53\u5ea6\u7ed3\u8bba\uff0c\u4e5f\u6709\u70b9\u6269\u5c55\u8fd9\u65b9\u9762\u7b97\u6cd5\u80fd\u529b\u7684\u610f\u601d</p>"},{"location":"graphTheory/#_1","title":"\u56fe\u8bba\u5e94\u8bd5\u6280\u5de7","text":""},{"location":"graphTheory/#_2","title":"\u57fa\u672c\u6982\u5ff5","text":"<p>1.\uff08prerequisite\uff1a\u81ea\u540c\u6784\uff09\u9876\u70b9\u4f20\u9012\u6027\u7684\u4f8b\u5b50\uff1ar=s\u7684\u4e8c\u90e8\u56fe\uff0c\u73af/\u5e94\u7528\uff1a\u8bc1\u660e\u4e00\u4e2a\u9876\u70b9\u6ee1\u8db3=&gt;\u6240\u6709\u9876\u70b9\u6ee1\u8db3</p>"},{"location":"graphTheory/#_3","title":"\u8fde\u901a\u6027","text":"<p>1.\u8fde\u901a\u6027\u5224\u636e\uff1a\u4ece\u4efb\u4f55\u9876\u70b9\u90fd\u6709\u4e00\u6761\u5230\u67d0\u9876\u70b9\u7684path 2.\u5272\u8fb9\u5224\u636e\uff1a\u4e0d\u5c5e\u4e8e\u4efb\u4f55\u4e00\u4e2a\u73af</p>"},{"location":"graphTheory/#_4","title":"\u4e8c\u90e8\u56fe","text":"<p>1.Konig\u5b9a\u7406\uff1a\u4e8c\u90e8\u56fe&lt;=&gt;\u4e0d\u5305\u542b\u5947\u73af 2.\u4e8c\u90e8\u56fe\u7684\u5426\u5b9a\uff1a\u627e\u5230\u4e00\u4e2a\u5947\u73af 3.\u5b8c\u5168\u56feKn\u8868\u793a\u6210k\u4e2a\u4e8c\u90e8\u56fe\u7684\u5e76\uff1a\u6bcf\u4e2a\u9876\u70b9\u8d4b\u7ed9\u4e00\u4e2ak\u4f4d\u5b57\u7b26\u4e32\uff0c\u7b2ci\u4e2a\u4e8c\u90e8\u56fe\u5c31\u662f\u5bf9\u7b2ci\u4f4d\u5b57\u7b26\u8fdb\u884c\u5206\u7c7b=&gt;n&lt;=2^k</p>"},{"location":"graphTheory/#_5","title":"\u6b27\u62c9\u8ff9","text":"<p>1.\u73af\u5b58\u5728\u5f15\u7406\uff1aG\u4e2d\u6bcf\u4e00\u4e2a\u9876\u70b9\u7684\u5ea6\u81f3\u5c11\u662f2\uff0c\u5219G\u542b\u6709\u4e00\u4e2a\u73af 2.\u5076\u56fe\u5206\u89e3\u5f15\u7406\uff1a\u4efb\u4f55\u5076\u56fe\u53ef\u4ee5\u5206\u89e3\u6210\u82e5\u5e72\u4e2a\u73af 3.\u6781\u7aef\u5316\u65b9\u6cd5\uff0c\u7279\u522b\u662f\u6784\u9020\u6027\u8bc1\u660e\u3002\u4f8b\u5b50-\u53d6\u6781\u5927\u8def\u5f84\uff08\u4e0d\u53ef\u6269\u5c55\u7684\u7b80\u5355\u8def\u5f84\uff09\uff0c\u8bc1\u660e\u7b80\u5355\u56fe\u81f3\u5c11\u6709\u4e24\u4e2a\u9876\u70b9\u4e0d\u662f\u5272\u70b9 4.\u6b27\u62c9\u8ff9\u5206\u89e3\u5b9a\u7406\uff1a\u5bf9\u4e8e\u75312k\u4e2a\u5947\u9876\u70b9\u7684\u8fde\u901a\u56fe\uff0c\u5206\u89e3\u5b83\u6070\u9700\u8981k\u4e2atrace\uff08k\u4e3a\u6b63\uff09</p>"},{"location":"graphTheory/#_6","title":"\u7ec4\u5408\u6781\u503c","text":"<p>1.\u6781\u5927\u4e8c\u90e8\u56fe\u5b9a\u7406\uff1a\u6bcf\u4e2a\u65e0\u5708\u56feG\u90fd\u6709\u4e00\u4e2a\u4e8c\u90e8\u5b50\u56fe\u81f3\u5c11\u5305\u542b\u4e86e(G)/2\u6761\u8fb9\uff1b\u6784\u9020\u6027\u8bc1\u660e\u53ef\u7528\u4e8e\u5bfb\u627e\u6781\u5927\u5b50\u56fe\u3002 2.\u8292\u6cf0\u5c14\uff08Mantel\uff09\u5b9a\u7406\uff1an-\u9876\u70b9\u7684\u4e09\u89d2\u5f62\u65e0\u5173\u7b80\u5355\u56fe\u4e2d\uff0c\u6700\u5927\u8fb9\u6570\u662f\\floor{n^2/4}\uff0c\u5728\u5b8c\u5168\u4e8c\u90e8\u56fe\u4e0a\u53d6\u5230\u3002</p>"},{"location":"graphTheory/#_7","title":"\u6709\u5411\u56fe","text":"<p>1.\u5fc5\u80dc\u7b56\u7565\uff1a\u5bfb\u627e\u5305\u542b\u80dc\u5229\u72b6\u6001W\u7684\u6838S\uff0c\u4f7f\u81ea\u5df1\u7ef4\u6301\u5728\u8fd9\u4e2aS\u4e2d\u3002\u800c\u65e0\u73af\u7684\u6e38\u620f\u5fc5\u5b58\u5728\u8fd9\u6837\u7684S 2.\u7406\u67e5\u5fb7\u68ee\uff08Richardson\uff09\u5b9a\u7406\uff1a\u6ca1\u6709\u5947\u73af\u7684\u4efb\u610f\u6709\u5411\u56fe\u5747\u6709\u4e00\u4e2a\u6838 3.\u6709\u5411\u56fe\u5ea6\u5bf9\u7684\u5145\u8981\u6761\u4ef6\uff1a\u975e\u8d1f\u6574\u6570\u5bf9\u7684\u4e00\u4e2a\u5e8f\u5217\u662f\u67d0\u4e2a\u6709\u5411\u56fe\u7684\u5ea6\u5bf9\u5e8f\u5217&lt;=&gt;\u7b2c\u4e00\u4e2a\u5750\u6807\u7684\u548c\u7b49\u4e8e\u7b2c\u4e8c\u4e2a\u5750\u6807\u7684\u548c 4.(\u6982\u5ff5\uff09\u6709\u5411\u56fe\u7684\u5206\u88c2 5.\u6709\u5411\u56fe\u73af\u5b58\u5728\u5f15\u7406\uff1a\u82e5G\u5165\u5ea6\u6700\u5c0f\u503c\u5927\u4e8e\u7b49\u4e8e1\uff0c\u6216G\u51fa\u5ea6\u5927\u4e8e\u7b49\u4e8e1\uff0c\u5219G\u5305\u542b\u4e00\u4e2a\u73af 6.\u6717\u9053\u547d\u9898\uff1a\u4efb\u4f55\u7ade\u8d5b\u56fe\uff08\u5b8c\u5168\u56fe\u7684\u5b9a\u5411\uff09\u90fd\u6709\u4e00\u4e2a\u738b\uff08\u5230\u6240\u6709\u9876\u70b9\u90fd\u6709\u5c0f\u4e8e\u7b49\u4e8e2\u7684\u8def\u5f84\uff09</p>"},{"location":"infoTheory/","title":"infoTheory","text":"<p>\u9884\u8ba1\u4ee5\u624b\u7a3f\u5f62\u5f0f\u4e0a\u4f20</p>"},{"location":"mathematicalMethod/","title":"mathematicalMethod","text":""},{"location":"mathematicalMethod/#_1","title":"\u6559\u6750\uff1a\u6881\u6606\u6dfc\u300a\u6570\u5b66\u7269\u7406\u65b9\u6cd5\u300b","text":"<p>\u4e3b\u8981\u5185\u5bb9\u5305\u62ec\uff1a\u590d\u53d8\u51fd\u6570\uff0c\u5efa\u6a21\u65b9\u6cd5\uff0c\u51e0\u7c7b\u5178\u578b\u7684\u504f\u5fae\u5206\u65b9\u7a0b</p> <p>\u6ce8\uff1a\u672c\u7248\u5757\u7684\u590d\u53d8\u51fd\u6570\u4ecd\u7136\u662f\u5de5\u79d1\u89c6\u89d2\u7684\u3002\u901a\u8fc7\u8fd9\u95e8\u7269\u7406\u8bfe\u5b66\u4e60\u6570\u5b66\u7684\u4e00\u4e2a\u91cd\u8981\u539f\u56e0\u662f\u8fd9\u4e3a\u6570\u5b66\u63d0\u4f9b\u4e86\u52a8\u673a\u3002</p>"},{"location":"mathematicalMethod/#_2","title":"\u89e3\u6790\u51fd\u6570\u53ca\u5176\u4e09\u4e2a\u91cd\u8981\u6027\u8d28","text":"<p>\u89e3\u6790\u51fd\u6570</p>"},{"location":"repair/","title":"Repair","text":""},{"location":"repair/#mkdocs","title":"\u90e8\u7f72mkdocs","text":"<pre><code>mkdocs build\ngit init\ngit add .\ngit commit -m \"Deploy site\"\ngit remote add origin https://github.com/your-username/your-repo.git\ngit branch -M gh-pages\ngit push -u origin gh-pages --force\n</code></pre> <p>\u9047\u5230\u95ee\u9898</p> <pre><code>Permission denied (publickey).\n</code></pre> <p>\u89e3\u51b3\uff1a</p> <pre><code>ssh-keygen -t ed25519 -C \"your_email@example.com\"\neval \"$(ssh-agent -s)\"\nssh-add ~/.ssh/id_ed25519\n</code></pre> <p>\u5c06\u516c\u94a5\u6dfb\u52a0\u5230 GitHub \u8d26\u6237</p> <pre><code>ssh -T git@github.com\n</code></pre> <pre><code>git push -u origin gh-pages --force\n</code></pre> <p>\u9047\u5230\u95ee\u9898 gitpage\u4ec5\u663e\u793a\u6839\u76ee\u5f55\u4e0b\u7684readme\uff0c\u6ca1\u6709\u663e\u793asite/ \u89e3\u51b3\uff1a \u8c03\u6574 mkdocs.yml \u914d\u7f6e</p> <pre><code>site_name: My Docs\nrepo_url: https://github.com/your-username/your-repo\ndocs_dir: docs\nsite_dir: site\nmkdocs build --clean\nmkdocs gh-deploy --force\n</code></pre> <p>github-setting-pages-branch: /root</p>"},{"location":"rl/","title":"RL","text":""},{"location":"rl/#_1","title":"\u5f3a\u5316\u5b66\u4e60","text":"<p>\u7b14\u8bb0</p>"}]}